# Source of truth for site routing. Version-controlled here, pushed to the
# server with ./deploy.sh. cloud-init installs this same file on first boot,
# so a rebuilt server comes up with current routing rather than a stale copy.
#
# Do NOT edit /etc/caddy/Caddyfile on the server directly — the next deploy
# overwrites it and the change is lost.

leonardzimdars.com, www.leonardzimdars.com {
	# One canonical host: www redirects to the apex, preserving path and query.
	#
	# Caddy issues ONE CERTIFICATE PER HOSTNAME regardless of how site blocks
	# are grouped — leonardzimdars.com.crt and www.leonardzimdars.com.crt are
	# separate, each with a single SAN. Grouping the names here does not merge
	# them. Both renew automatically, so this costs nothing.
	#
	# www needs a certificate of its own precisely because it is redirected:
	# an https:// request cannot be answered, even with a 301, until the TLS
	# handshake completes.
	@www host www.leonardzimdars.com
	redir @www https://leonardzimdars.com{uri} permanent

	root * /var/www/site
	file_server
	encode zstd gzip

	# Astro fingerprints everything under /_astro/ with a content hash, so those
	# files are immutable by construction and can be cached forever. The HTML
	# that references them is deliberately NOT cached here: it must be refetched
	# for a deploy to be visible at all.
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"

	# Caddy has no MIME entry for .webmanifest, so it sends no Content-Type at
	# all. Normally a browser would sniff; `X-Content-Type-Options: nosniff`
	# below forbids that, so without this the manifest is fetched and then
	# discarded.
	header /site.webmanifest Content-Type "application/manifest+json"

	header {
		# Only meaningful over HTTPS, which is the only way this is served.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# The site ships no JavaScript and loads nothing cross-origin, so a
		# restrictive policy costs nothing. Revisit before adding analytics,
		# an embed, or a web font.
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
	}

	# Caddy obtains and renews the Let's Encrypt certificate itself. There is
	# no certbot and no renewal cron. Plain HTTP is redirected to HTTPS
	# automatically — that redirect is not configured anywhere on purpose.
}

# --- Adding a project ------------------------------------------------------
# Each new site is a block here plus a DNS record in dns.tf. No server change,
# no Terraform apply for the server itself.
#
# Static, from its own directory:
#
# blog.leonardzimdars.com {
# 	root * /var/www/blog
# 	file_server
# 	encode zstd gzip
# }
#
# Containerized, proxied to a local port:
#
# api.leonardzimdars.com {
# 	reverse_proxy localhost:3000
# }
#
# NOTE: a hostname must already resolve to this server BEFORE it appears here.
# Caddy requests a certificate on reload, and Let's Encrypt rate-limits failed
# validations to 5 per hostname per hour.
# ---------------------------------------------------------------------------
