#cloud-config
# Runs ONCE, on first boot. Editing this file forces server replacement.
hostname: ${hostname}

users:
  - name: ${admin_user}
    groups: [sudo, docker]
    shell: /bin/bash
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    ssh_authorized_keys:
      - ${ssh_public_key}

# Key-only auth. This is what makes an internet-facing port 22 acceptable.
ssh_pwauth: false
disable_root: true

package_update: true
package_upgrade: true

packages:
  - ca-certificates
  - curl
  - gnupg
  - debian-keyring
  - debian-archive-keyring
  - apt-transport-https
  - fail2ban
  - unattended-upgrades

write_files:
  # Injected verbatim from the repo's ./Caddyfile — that file is the source of
  # truth. Ongoing changes go out via ./deploy.sh, not by editing this template
  # (editing this template forces a full server rebuild).
  #
  # STAGED HERE, NOT AT /etc/caddy/Caddyfile. write_files runs before runcmd, so
  # pre-creating that path makes dpkg see an unowned conffile during install,
  # prompt interactively, fail on absent stdin, and abort configuring the
  # package — leaving no caddy user and a dead service. runcmd installs it into
  # place after the package is configured.
  - path: /opt/bootstrap/Caddyfile
    content: |
      ${indent(6, caddyfile)}

  - path: /var/www/site/index.html
    content: |
      <!doctype html>
      <meta charset="utf-8">
      <title>Provisioned</title>
      <style>
        body { font-family: system-ui, sans-serif; max-width: 34rem;
               margin: 20vh auto; padding: 0 1.5rem; line-height: 1.6; }
        code { background: #eee; padding: .15em .4em; border-radius: 3px; }
      </style>
      <h1>Server is up.</h1>
      <p>Caddy is serving this from <code>/var/www/site</code>.
         Replace it with your real site.</p>

  # Security patches apply themselves; nothing else auto-upgrades.
  - path: /etc/apt/apt.conf.d/20auto-upgrades
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";

  # Numbered above 50unattended-upgrades so it wins. APT list syntax APPENDS,
  # so the Ubuntu security origins from the stock file are preserved and these
  # are added to them — do not restate the Ubuntu entries here.
  - path: /etc/apt/apt.conf.d/52unattended-upgrades-local
    content: |
      // Stock config covers Ubuntu origins only, which leaves the two
      // internet-facing third-party packages unpatched forever.
      // Strings come from: apt-cache policy | grep -oE 'o=[^,]+,a=[^,]+'
      Unattended-Upgrade::Allowed-Origins {
          "cloudsmith/caddy/stable:any-version";
          "Docker:$${distro_codename}";
      };

      // Kernel and libc updates need a reboot to take effect. Without this the
      // box silently accumulates pending reboots and keeps running the old,
      // vulnerable kernel. ~30s of downtime at 04:00 beats that trade for a
      // static site — reconsider once stateful services live here.
      Unattended-Upgrade::Automatic-Reboot "true";
      Unattended-Upgrade::Automatic-Reboot-WithUsers "true";
      Unattended-Upgrade::Automatic-Reboot-Time "04:00";

      // Keep /boot from filling up with superseded kernels.
      Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";
      Unattended-Upgrade::Remove-Unused-Dependencies "true";

runcmd:
  # --- Caddy (official Cloudsmith repo) ---
  - curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/gpg.key' | gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg
  - curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt' -o /etc/apt/sources.list.d/caddy-stable.list

  # --- Docker (official repo) — for future containerized projects ---
  - install -m 0755 -d /etc/apt/keyrings
  - curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  - chmod a+r /etc/apt/keyrings/docker.asc
  - echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo $VERSION_CODENAME) stable" > /etc/apt/sources.list.d/docker.list

  # noninteractive + force-confold so no package can ever block on a conffile
  # prompt the way caddy did. A prompt here aborts the whole bootstrap.
  - DEBIAN_FRONTEND=noninteractive apt-get update
  - DEBIAN_FRONTEND=noninteractive apt-get install -y -o Dpkg::Options::=--force-confold caddy docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

  # Only now that the package is configured does the caddy user exist.
  - install -o root -g root -m 644 /opt/bootstrap/Caddyfile /etc/caddy/Caddyfile
  - chown -R caddy:caddy /var/www/site
  - systemctl enable --now caddy docker fail2ban
  - systemctl restart caddy

final_message: "Bootstrap finished after $UPTIME seconds."

# package_upgrade installs a newer kernel than the base image ships, so a fresh
# build otherwise sits on the OLD kernel until unattended-upgrades reboots it at
# 04:00 — up to a day on an unpatched kernel every rebuild. Reboot here instead,
# but only when something actually requires it.
power_state:
  mode: reboot
  message: Rebooting to activate newly installed kernel
  condition: test -f /var/run/reboot-required
  timeout: 30
